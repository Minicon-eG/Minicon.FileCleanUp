{
  "FileCleanUp": {
    "DryRun": true,
    "MinimumRetentionDays": 14,
    "DeleteDelayMilliseconds": 0,
    "MaxFilesToDeletePerRun": 50000,
    "Audit": { "Mode": "LoggingOnly" },
    "Resilience": { "MaxAttempts": 6 },
    "Rules": [
      {
        "Name": "Exports",
        "Directories": [{ "Kind": "Path", "Root": "C:\\Data\\Exports" }],
        "RetentionDays": 90,
        "Recursive": true,
        "RemoveEmptyDirectories": true,
        "IncludePatterns": ["*.csv", "*.zip"],
        "ExcludeDirectories": [{ "Kind": "Glob", "Pattern": "**/Protected" }]
      }
    ]
  },
  "Seq": { "ServerUrl": "" }
}
