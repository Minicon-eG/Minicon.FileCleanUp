<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.1.0</Version>
    <PackageId>Minicon.FileCleanUp</PackageId>
    <Authors>Minicon eG</Authors>
    <Description>Age-based file cleanup for customer console applications with dry run, structured logging, bounded retries and durable audit.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Minicon-eG/Minicon.FileCleanUp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Minicon-eG/Minicon.FileCleanUp</PackageProjectUrl>
    <PackageReleaseNotes>Adds legacy global configuration aliases and combined UTC timestamp selection. See CHANGELOG.md for scope and compatibility limits.</PackageReleaseNotes>
    <PackageTags>cleanup;filesystem;dry-run;audit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference PrivateAssets="all" Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/index.html" Pack="true" PackagePath="docs/" />
    <None Include="../../build/Minicon.FileCleanUp.targets" Pack="true" PackagePath="build/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Minicon.FileCleanUp.Domain/Minicon.FileCleanUp.Domain.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Minicon.FileCleanUp.Core/Minicon.FileCleanUp.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="../Minicon.FileCleanUp.Infrastructure/Minicon.FileCleanUp.Infrastructure.csproj" PrivateAssets="all" />
  </ItemGroup>
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeLayerAssemblies</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="IncludeLayerAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference'" />
    </ItemGroup>
  </Target>
</Project>
