<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0-preview.2</Version>
    <PackageId>Minicon.FileCleanUp</PackageId>
    <Authors>Minicon eG</Authors>
    <Description>Testable age-based cleanup for customer console applications. Development preview.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Minicon-eG/Minicon.FileCleanUp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cleanup;filesystem;dry-run;audit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
    <PackageReference PrivateAssets="all" Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TestableIO.System.IO.Abstractions.Wrappers" Version="22.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/index.html" Pack="true" PackagePath="docs/" />
    <None Include="../../build/Minicon.FileCleanUp.targets" Pack="true" PackagePath="build/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
